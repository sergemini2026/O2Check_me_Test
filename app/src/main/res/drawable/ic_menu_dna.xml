<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Левая нить спирали -->
    <path
        android:pathData="M7,3 C13,7 11,13 17,21"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="7" android:startY="3" android:endX="17" android:endY="21">
                <item android:color="#E0E0E0" android:offset="0.0" />
                <item android:color="#606060" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Правая нить спирали -->
    <path
        android:pathData="M17,3 C11,7 13,13 7,21"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="17" android:startY="3" android:endX="7" android:endY="21">
                <item android:color="#E0E0E0" android:offset="0.0" />
                <item android:color="#606060" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Горизонтальные перемычки -->
    <path
        android:pathData="M9,7h6 M10,12h4 M9,17h6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="9" android:startY="7" android:endX="15" android:endY="17">
                <item android:color="#D0D0D0" android:offset="0.0" />
                <item android:color="#707070" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
